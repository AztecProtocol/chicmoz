{
  "name": "@chicmoz/test-harness",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "scripts": {
    "prebuild": "rm -rf build; mkdir build",
    "build": "yarn tsc -p tsconfig.build.json",
    "lint": "yarn run lint-base --ext .ts .",
    "lint-base": "yarn run g:lint",
    "test": "vitest run --dir src --exclude '**/*.integration.test.ts'",
    "test-once": "vitest run --dir src --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "harness": "yarn build > /dev/null && node build/cli.js",
    "record-fixtures": "yarn build > /dev/null && node build/recorder/cli.js"
  },
  "dependencies": {
    "bson": "6.2.0",
    "drizzle-orm": "0.33.0",
    "pg": "8.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aztec-foundation/l1-artifacts": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/protocol-contracts": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.11.8",
    "@typescript-eslint/eslint-plugin": "6.11.0",
    "@typescript-eslint/parser": "6.11.0",
    "eslint": "8.53.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.29.0",
    "kafkajs": "2.2.4",
    "typescript": "5.8.3",
    "viem": "2.20.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.7.1"
  },
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ]
}
