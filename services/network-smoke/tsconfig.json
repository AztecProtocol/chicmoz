{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build",
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "paths": {
      "@chicmoz/test-harness": ["../../packages/test-harness/src/index.ts"]
    }
  },
  "include": ["src", "vitest.smoke.config.ts"]
}
