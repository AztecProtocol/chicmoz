{"artifact_version":1,"noir_version":"1.0.0-rc.3+5a7ee9bf5ed8973076df7bb0d2b723024db09ae7","name":"SimpleLogging","functions":[{"name":"__aztec_nr_internals__get_counter","hash":"2949078061076472402","is_unconstrained":true,"custom_attributes":["abi_utility"],"abi":{"abi_version":1,"parameters":[{"name":"owner","type":{"kind":"struct","path":"aztec::protocol_types::address::aztec_address::AztecAddress","fields":[{"name":"inner","type":{"kind":"field"}}]},"visibility":"private"}],"return_type":{"abi_type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},"error_types":{"459713770342432051":{"error_kind":"string","string":"Not initialized"},"13455385521185560676":{"error_kind":"string","string":"Storage slot 0 not allowed. Storage slots must start from 1."},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"},"16431471497789672479":{"error_kind":"string","string":"Index out of bounds"}}},"bytecode":"","debug_symbols":""},{"name":"__aztec_nr_internals__increment","hash":"7669230636319615396","is_unconstrained":true,"custom_attributes":["abi_public"],"abi":{"abi_version":1,"parameters":[{"name":"owner","type":{"kind":"struct","path":"aztec::protocol_types::address::aztec_address::AztecAddress","fields":[{"name":"inner","type":{"kind":"field"}}]},"visibility":"private"}],"return_type":null,"error_types":{"459713770342432051":{"error_kind":"string","string":"Not initialized"},"13455385521185560676":{"error_kind":"string","string":"Storage slot 0 not allowed. Storage slots must start from 1."},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"}}},"bytecode":"","debug_symbols":""},{"name":"__aztec_nr_internals__initialize","hash":"1536346635774431203","is_unconstrained":true,"custom_attributes":["abi_public","abi_initializer"],"abi":{"abi_version":1,"parameters":[{"name":"headstart","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"},{"name":"owner","type":{"