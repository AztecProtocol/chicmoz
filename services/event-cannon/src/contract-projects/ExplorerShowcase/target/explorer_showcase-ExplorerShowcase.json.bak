l_types::address::aztec_address::AztecAddress","fields":[{"name":"inner","type":{"kind":"field"}}]}]},"10033682601308824536":{"error_kind":"string","string":"Ephemeral public key is the point at infinity"},"10522114655416116165":{"error_kind":"string","string":"Can't read a transient note with a zero contract address"},"10835759466430049078":{"error_kind":"string","string":"Collapse hint vec length mismatch"},"11088061827347467743":{"error_kind":"string","string":"Note owner mismatch."},"11247938725352536229":{"error_kind":"string","string":"ExplorerShowcase: no note found for unshield"},"11479794509897824893":{"error_kind":"string","string":"freshly bootstrapped secret must start at index 0"},"12469291177396340830":{"error_kind":"string","string":"call to assert_max_bit_size"},"12820178569648940736":{"error_kind":"fmtstring","length":48,"item_types":[{"kind":"field"},{"kind":"field"}]},"12913276134398371456":{"error_kind":"string","string":"push out of bounds"},"13049348927268151465":{"error_kind":"string","string":"Dirty collapsed vec storage"},"13671158251341025138":{"error_kind":"string","string":"Got more notes than limit."},"14320851680071140034":{"error_kind":"fmtstring","length":56,"item_types":[{"kind":"integer","sign":"unsigned","width":32}]},"14367107770810432241":{"error_kind":"fmtstring","length":237,"item_types":[{"kind":"integer","sign":"unsigned","width":32},{"kind":"integer","sign":"unsigned","width":32}]},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"},"15835548349546956319":{"error_kind":"string","string":"Field failed to decompose into specified 32 limbs"},"16431471497789672479":{"error_kind":"string","string":"Index out of bounds"},"16466267804227883608":{"error_kind":"string","string":"Got an ephemeral public key with a negative y coordinate"},"17110599087403377004":{"error_kind":"fmtstring","length":98,"item_types":[]},"17235302588283887607":{"error_kind":"string","string":"an unconstrained tagging secret