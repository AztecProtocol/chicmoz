    "/l2/blocks/{heightOrHash}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "heightOrHash",
            "required": true,
            "schema": {
              "oneOf": [
                {
                  "pattern": "^0x[a-fA-F0-9]+$",
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "archive": {
                      "properties": {
                        "nextAvailableLeafIndex": {
                          "type": "number"
                        },
                        "root": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "root",
                        "nextAvailableLeafIndex"
                      ],
                      "type": "object"
                    },
                    "body": {
                      "properties": {
                        "txEffects": {
                          "items": {
                            "properties": {
                              "txHash": {}
                            },
                            "required": [
                              "txHash"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "txEffects"
                      ],
                      "type": "object"
                    },
                    "hash": {},
                    "header": {
                      "properties": {
                        "globalVariables": {
                          "properties": {
                            "blockNumber": {
                              "maximum": 9007199254740991,
                              "minimum": 0,
                              "type": "integer"
                            },
                            "chainId": {
                              "maximum": 9007199254740991,
                              "minimum": 0,
                              "type": "integer"
                            },
                            "coinbase": {
                              "maxLength": 42,
                              "minLength": 42,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            },
                            "feeRecipient": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            },
                            "gasFees": {
                              "properties": {
                                "feePerDaGas": {
                                  "pattern": "^\\d+$",
                                  "type": "string"
                                },
                                "feePerL2Gas": {
                                  "pattern": "^\\d+$",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "feePerDaGas",
                                "feePerL2Gas"
                              ],
                              "type": "object"
                            },
                            "slotNumber": {
                              "maximum": 9007199254740991,
                              "minimum": 0,
                              "type": "integer"
                            },
                            "timestamp": {
                              "maximum": 9007199254740991,
                              "minimum": 0,
                              "type": "integer"
                            },
                            "version": {
                              "maximum": 9007199254740991,
                              "minimum": 0,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "chainId",
                            "version",
                            "blockNumber",
                            "slotNumber",
                            "timestamp",
                            "coinbase",
                            "feeRecipient",
                            "gasFees"
                          ],
                          "type": "object"
                        },
                        "lastArchive": {
                          "properties": {
                            "nextAvailableLeafIndex": {
                              "type": "number"
                            },
                            "root": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            }
                          },
                          "required": [
                            "root",
                            "nextAvailableLeafIndex"
                          ],
                          "type": "object"
                        },
                        "spongeBlobHash": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "state": {
                          "properties": {
                            "l1ToL2MessageTree": {
                              "properties": {
                                "nextAvailableLeafIndex": {
                                  "type": "number"
                                },
                                "root": {
                                  "maxLength": 66,
                                  "minLength": 66,
                                  "pattern": "^0x[0-9a-fA-F]+$",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "root",
                                "nextAvailableLeafIndex"
                              ],
                              "type": "object"
                            },
                            "partial": {
                              "properties": {
                                "noteHashTree": {
                                  "properties": {
                                    "nextAvailableLeafIndex": {
                                      "type": "number"
                                    },
                                    "root": {
                                      "maxLength": 66,
                                      "minLength": 66,
                                      "pattern": "^0x[0-9a-fA-F]+$",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "root",
                                    "nextAvailableLeafIndex"
                                  ],
                                  "type": "object"
                                },
                                "nullifierTree": {
                                  "properties": {
                                    "nextAvailableLeafIndex": {
                                      "type": "number"
                                    },
                                    "root": {
                                      "maxLength": 66,
                                      "minLength": 66,
                                      "pattern": "^0x[0-9a-fA-F]+$",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "root",
                                    "nextAvailableLeafIndex"
                                  ],
                                  "type": "object"
                                },
                                "publicDataTree": {
                                  "properties": {
                                    "nextAvailableLeafIndex": {
                                      "type": "number"
                                    },
                                    "root": {
                                      "maxLength": 66,
                                      "minLength": 66,
                                      "pattern": "^0x[0-9a-fA-F]+$",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "root",
                                    "nextAvailableLeafIndex"
                                  ],
                                  "type": "object"
                                }
                              },
                              "required": [
                                "noteHashTree",
                                "nullifierTree",
                                "publicDataTree"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "l1ToL2MessageTree",
                            "partial"
                          ],
                          "type": "object"
                        },
                        "totalFees": {
                          "type": "string"
                        },
                        "totalManaUsed": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "lastArchive",
                        "spongeBlobHash",
                        "state",
                        "globalVariables",
                        "totalFees",
                        "totalManaUsed"
                      ],
                      "type": "object"
                    },
                    "height": {
                      "type": "string"
                    },
                    "nativeStatus": {
                      "description": "Product-facing Aztec-native block status derived from current L2 tips. `checkpointed` is a native L2 tip bucket; on Aztec v4, upstream `finalized` may equal `proven`.",
                      "enum": [
                        "proposed",
                        "checkpointed",
                        "proven",
                        "finalized",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "orphan": {
                      "properties": {
                        "hasOrphanedParent": {
                          "type": "boolean"
                        },
                        "timestamp": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "timestamp",
                        "hasOrphanedParent"
                      ],
                      "type": "object"
                    },
                    "proofVerifiedOnL1": {
                      "properties": {
                        "isFinalized": {
                          "type": "boolean"
                        },
                        "l1BlockHash": {
                          "type": "string"
                        },
                        "l1BlockNumber": {
                          "type": "string"
                        },
                        "l1BlockTimestamp": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "l1ContractAddress": {
                          "type": "string"
                        },
                        "proverId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "l1ContractAddress",
                        "l1BlockNumber",
                        "l1BlockHash",
                        "isFinalized",
                        "proverId"
                      ],
                      "type": "object"
                    },
                    "proposedOnL1": {
                      "properties": {
                        "archive": {
                          "type": "string"
                        },
                        "isFinalized": {
                          "type": "boolean"
                        },
                        "l1BlockHash": {
                          "type": "string"
                        },
                        "l1BlockNumber": {
                          "type": "string"
                        },
                        "l1BlockTimestamp": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "l1ContractAddress": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "l1ContractAddress",
                        "l1BlockNumber",
                        "l1BlockHash",
                        "isFinalized",
                        "archive"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "hash",
                    "height",
                    "archive",
                    "header",
                    "body"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get a block by height or hash",
        "tags": [
          "L2",
          "blocks"
        ]
      }
