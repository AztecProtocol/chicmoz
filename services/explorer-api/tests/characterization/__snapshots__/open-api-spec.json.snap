{
  "externalDocs": {
    "description": "Experimental Aztec Scan SDK",
    "url": "https://github.com/aztec-scan/aztec-scan-sdk"
  },
  "info": {
    "contact": {
      "name": "Github",
      "url": "https://github.com/AztecProtocol/chicmoz"
    },
    "description": "API for exploring Aztec Network. Please note that this is a work in progress and the API is subject to change.\n\nCurrently there is no sign-up process for an API key. There will however be rate limits in place.\n\nThis is also subject to change, and the latest updates on this will always be available here.\n\nExperimental SDK can be found here: [aztec-scan-sdk](https://github.com/aztec-scan/aztec-scan-sdk)",
    "title": "Aztec Scan API",
    "version": "SNAPSHOT"
  },
  "openapi": "3.1.0",
  "paths": {
    "/l1/contract-events": {
      "get": {
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "eventArgs": {
                      "additionalProperties": {},
                      "propertyNames": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "eventName": {
                      "type": "string"
                    },
                    "id": {
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string"
                    },
                    "isFinalized": {
                      "default": false,
                      "type": "boolean"
                    },
                    "l1BlockHash": {
                      "pattern": "^0x.*",
                      "type": "string"
                    },
                    "l1BlockNumber": {
                      "type": "string"
                    },
                    "l1BlockTimestamp": {
                      "type": "string"
                    },
                    "l1ContractAddress": {
                      "type": "string"
                    },
                    "l1LogIndex": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": 0,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "l1TransactionHash": {
                      "anyOf": [
                        {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "eventName",
                    "l1BlockNumber",
                    "l1BlockHash",
                    "l1BlockTimestamp",
                    "l1ContractAddress",
                    "isFinalized"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get L1 contract events",
        "tags": [
          "L1",
          "contract-events"
        ]
      }
    },
    "/l1/contract-events/hourly-counts": {
      "get": {
        "parameters": [
          {
            "description": "Window in hours (1–168). Defaults to 24.",
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 168,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "count": {
                        "type": "integer"
                      },
                      "hourStartMs": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "hourStartMs",
                      "count"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Sparse list of buckets — empty hours are omitted, callers fill in zeros."
          }
        },
        "summary": "Per-hour L1 contract event counts over a rolling window",
        "tags": [
          "L1",
          "contract-events"
        ]
      }
    },
    "/l1/fee-juice-portal-deposits/{address}": {
      "get": {
        "parameters": [
          {
            "description": "L2 recipient address (bytes32 / Fr hex)",
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "amount": {
                        "description": "Fee juice amount in wei (bigint as string)",
                        "type": "string"
                      },
                      "index": {
                        "description": "Inbox leaf index (bigint as string)",
                        "type": "string"
                      },
                      "isFinalized": {
                        "type": "boolean"
                      },
                      "key": {
                        "description": "Inbox message key (bytes32)",
                        "type": "string"
                      },
                      "l1BlockHash": {
                        "type": "string"
                      },
                      "l1BlockNumber": {
                        "type": "string"
                      },
                      "l1BlockTimestamp": {
                        "type": "number"
                      },
                      "l1ContractAddress": {
                        "type": "string"
                      },
                      "l1LogIndex": {
                        "type": "number"
                      },
                      "l1Sender": {
                        "description": "L1 address of the depositor (msg.sender on portal tx)",
                        "type": "string"
                      },
                      "l1TransactionHash": {
                        "type": "string"
                      },
                      "secretHash": {
                        "type": "string"
                      },
                      "to": {
                        "description": "L2 recipient address (bytes32/Fr hex)",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Fee juice deposits targeting this L2 address"
          }
        },
        "summary": "Get L1→L2 fee juice deposits for an L2 address (FeeJuicePortal.DepositToAztecPublic)",
        "tags": [
          "L1",
          "fee-juice"
        ]
      }
    },
    "/l1/governance/configurations": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of configurations"
          }
        },
        "summary": "List historical governance configurations",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/proposals": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of governance proposals"
          }
        },
        "summary": "List governance proposals",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/proposals/:proposalId": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "proposalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal detail"
          },
          "404": {
            "description": "Proposal not found"
          }
        },
        "summary": "Get a single governance proposal",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/proposals/:proposalId/signals": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "proposalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of signals"
          },
          "404": {
            "description": "Proposal not found"
          }
        },
        "summary": "List signals related to a proposal (by payload address)",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/proposals/:proposalId/votes": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "proposalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "support",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of votes"
          }
        },
        "summary": "List votes for a proposal",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/proposer-history": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of proposer history entries"
          }
        },
        "summary": "List governance proposer change history",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/signals": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "payloadAddress",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "round",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "signaler",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of signals"
          }
        },
        "summary": "List all governance signals",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/signals/payload/:payloadAddress": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "payloadAddress",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of signals for the payload"
          }
        },
        "summary": "List all signals for a specific payload",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/governance/signals/round/:round": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "round",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of signals for the round"
          }
        },
        "summary": "List all signals in a specific round",
        "tags": [
          "L1",
          "governance"
        ]
      }
    },
    "/l1/l2-validators": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "attester": {
                        "maxLength": 42,
                        "minLength": 42,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "firstSeenAt": {
                        "default": 1767225600000,
                        "type": "number"
                      },
                      "latestSeenChangeAt": {
                        "default": 1767225600000,
                        "type": "number"
                      },
                      "proposer": {
                        "maxLength": 42,
                        "minLength": 42,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "rollupAddress": {
                        "maxLength": 42,
                        "minLength": 42,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "stake": {
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          0,
                          1,
                          2,
                          3
                        ],
                        "type": "number"
                      },
                      "withdrawer": {
                        "maxLength": 42,
                        "minLength": 42,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "rollupAddress",
                      "attester",
                      "stake",
                      "withdrawer",
                      "proposer",
                      "status",
                      "firstSeenAt",
                      "latestSeenChangeAt"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get L1 and L2 validators",
        "tags": [
          "L1",
          "l2-validators"
        ]
      }
    },
    "/l1/l2-validators/:attesterAddress": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "attesterAddress",
            "required": true,
            "schema": {
              "format": "hex",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "attester": {
                      "maxLength": 42,
                      "minLength": 42,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "firstSeenAt": {
                      "default": 1767225600000,
                      "type": "number"
                    },
                    "latestSeenChangeAt": {
                      "default": 1767225600000,
                      "type": "number"
                    },
                    "proposer": {
                      "maxLength": 42,
                      "minLength": 42,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "rollupAddress": {
                      "maxLength": 42,
                      "minLength": 42,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "stake": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        0,
                        1,
                        2,
                        3
                      ],
                      "type": "number"
                    },
                    "withdrawer": {
                      "maxLength": 42,
                      "minLength": 42,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "rollupAddress",
                    "attester",
                    "stake",
                    "withdrawer",
                    "proposer",
                    "status",
                    "firstSeenAt",
                    "latestSeenChangeAt"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get L1L2Validator",
        "tags": [
          "L1",
          "l2-validators"
        ]
      }
    },
    "/l1/l2-validators/:attesterAddress/history": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "attesterAddress",
            "required": true,
            "schema": {
              "format": "hex",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "items": false,
                    "maxItems": 3,
                    "minItems": 3,
                    "prefixItems": [
                      {
                        "format": "date-time",
                        "type": "string"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "type": "array"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get L1L2Validator history",
        "tags": [
          "L1",
          "l2-validators"
        ]
      }
    },
    "/l1/l2-validators/totals": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "maxStake": {
                      "description": "uint256",
                      "type": "string"
                    },
                    "nonValidating": {
                      "type": "integer"
                    },
                    "stakeByStatus": {
                      "additionalProperties": {
                        "description": "uint256",
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "statusCounts": {
                      "additionalProperties": {
                        "type": "integer"
                      },
                      "type": "object"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "totalStake": {
                      "description": "uint256",
                      "type": "string"
                    },
                    "validating": {
                      "type": "integer"
                    },
                    "validatingStake": {
                      "description": "uint256",
                      "type": "string"
                    }
                  },
                  "required": [
                    "total",
                    "validating",
                    "nonValidating",
                    "statusCounts"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Validator totals"
          }
        },
        "summary": "Get validator totals by status",
        "tags": [
          "L1",
          "l2-validators"
        ]
      }
    },
    "/l2/artifacts/{artifactHash}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "artifactHash",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Artifact JSON"
          },
          "404": {
            "description": "Artifact not found"
          }
        },
        "summary": "Get artifact JSON by artifact hash",
        "tags": [
          "L2",
          "artifacts"
        ]
      }
    },
    "/l2/blocks": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "archive": {
                        "properties": {
                          "nextAvailableLeafIndex": {
                            "type": "number"
                          },
                          "root": {
                            "maxLength": 66,
                            "minLength": 66,
                            "pattern": "^0x[0-9a-fA-F]+$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "root",
                          "nextAvailableLeafIndex"
                        ],
                        "type": "object"
                      },
                      "body": {
                        "properties": {
                          "txEffects": {
                            "items": {
                              "properties": {
                                "txHash": {}
                              },
                              "required": [
                                "txHash"
                              ],
                              "type": "object"
                            },
                            "type": "array"
                          }
                        },
                        "required": [
                          "txEffects"
                        ],
                        "type": "object"
                      },
                      "hash": {},
                      "header": {
                        "properties": {
                          "globalVariables": {
                            "properties": {
                              "blockNumber": {
                                "maximum": 9007199254740991,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "chainId": {
                                "maximum": 9007199254740991,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "coinbase": {
                                "maxLength": 42,
                                "minLength": 42,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              },
                              "feeRecipient": {
                                "maxLength": 66,
                                "minLength": 66,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              },
                              "gasFees": {
                                "properties": {
                                  "feePerDaGas": {
                                    "pattern": "^\\d+$",
                                    "type": "string"
                                  },
                                  "feePerL2Gas": {
                                    "pattern": "^\\d+$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "feePerDaGas",
                                  "feePerL2Gas"
                                ],
                                "type": "object"
                              },
                              "slotNumber": {
                                "maximum": 9007199254740991,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "timestamp": {
                                "maximum": 9007199254740991,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "version": {
                                "maximum": 9007199254740991,
                                "minimum": 0,
                                "type": "integer"
                              }
                            },
                            "required": [
                              "chainId",
                              "version",
                              "blockNumber",
                              "slotNumber",
                              "timestamp",
                              "coinbase",
                              "feeRecipient",
                              "gasFees"
                            ],
                            "type": "object"
                          },
                          "lastArchive": {
                            "properties": {
                              "nextAvailableLeafIndex": {
                                "type": "number"
                              },
                              "root": {
                                "maxLength": 66,
