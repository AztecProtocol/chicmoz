    "/l2/ui/blocks-for-table": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "enum": [
                "proposed",
                "checkpointed",
                "proven",
                "finalized",
                "unknown",
                "orphaned"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "blockHash": {},
                      "coinbase": {
                        "maxLength": 42,
                        "minLength": 42,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "height": {
                        "type": "string"
                      },
                      "nativeStatus": {
                        "description": "Product-facing Aztec-native block status derived from L2 tips.",
                        "enum": [
                          "proposed",
                          "checkpointed",
                          "proven",
                          "finalized",
                          "unknown"
                        ],
                        "type": "string"
                      },
                      "orphan": {
                        "default": false,
                        "type": "boolean"
                      },
                      "timestamp": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "txEffectsLength": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "blockHash",
                      "height",
                      "timestamp",
                      "txEffectsLength",
                      "orphan"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get block table rows for the UI",
        "tags": [
          "L2",
          "ui",
          "blocks"
        ]
      }
    },
