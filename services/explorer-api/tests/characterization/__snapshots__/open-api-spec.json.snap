    "/l2/contract-classes/{classId}/versions/{version}/source": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "classId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "aztecVersion": {
                      "nullable": true,
                      "type": "string"
                    },
                    "contractClassId": {
                      "type": "string"
                    },
                    "gitRef": {
                      "nullable": true,
                      "type": "string"
                    },
                    "sourceCode": {
                      "items": {
                        "properties": {
                          "content": {
                            "type": "string"
                          },
                          "path": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "sourceCodeCommitHash": {
                      "nullable": true,
                      "type": "string"
                    },
                    "sourceCodeUrl": {
                      "type": "string"
                    },
                    "version": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Verified source code"
          },
          "404": {
            "description": "Contract class not found or source not verified"
          }
        },
        "summary": "Get verified source code for a contract class",
        "tags": [
          "L2",
          "contract-classes",
          "source-verification"
        ]
      }
    },
    "/l2/contract-classes/{classId}/versions/{version}/verify-source": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "classId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "gitRef": {
                    "type": "string"
                  },
                  "githubUrl": {
                    "type": "string"
                  },
                  "subPath": {
                    "type": "string"
                  }
                },
                "required": [
                  "githubUrl"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "jobId": {
                      "nullable": true,
                      "type": "string"
                    },
                    "sourceCodeUrl": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Source code already verified"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Verification job created"
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Contract class not found"
          },
          "429": {
            "description": "Too many concurrent verification requests"
          },
          "503": {
            "description": "Source verification is unavailable (archived rollup)"
          }
        },
        "summary": "Submit a source code verification request",
        "tags": [
          "L2",
          "contract-classes",
          "source-verification"
        ]
      }
    },
    "/l2/contract-classes/{classId}/versions/{version}/verify-source/{jobId}": {
      "get": {
        "parameters": [
          {
            "in": "path",
