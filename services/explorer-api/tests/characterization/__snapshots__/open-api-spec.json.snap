    "/l2/search": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "results": {
                      "properties": {
                        "accounts": {
                          "items": {
                            "properties": {
                              "address": {
                                "maxLength": 66,
                                "minLength": 66,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "address"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "blocks": {
                          "items": {
                            "properties": {
                              "blockNumber": {
                                "maximum": 9007199254740991,
                                "minimum": 0,
                                "type": "integer"
                              },
                              "hash": {},
                              "slotNumber": {
                                "maximum": 9007199254740991,
                                "minimum": 0,
                                "type": "integer"
                              }
                            },
                            "required": [
                              "hash",
                              "blockNumber",
                              "slotNumber"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "contractInstances": {
                          "items": {
                            "properties": {
                              "address": {
                                "maxLength": 66,
                                "minLength": 66,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              },
                              "partOfBlockWithHash": {}
                            },
                            "required": [
                              "address"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "droppedTx": {
                          "items": {
                            "properties": {
                              "txHash": {}
                            },
                            "required": [
                              "txHash"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "pendingTx": {
                          "items": {
                            "properties": {
                              "txHash": {}
                            },
                            "required": [
                              "txHash"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "registeredContractClasses": {
                          "items": {
                            "properties": {
                              "contractClassId": {
                                "maxLength": 66,
                                "minLength": 66,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              },
                              "partOfBlockWithHash": {},
                              "version": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "contractClassId",
                              "version"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "txEffects": {
                          "items": {
                            "properties": {
                              "partOfBlockWithHash": {},
                              "txHash": {}
                            },
                            "required": [
                              "txHash"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "validators": {
                          "items": {
                            "properties": {
                              "validatorAddress": {
                                "maxLength": 42,
                                "minLength": 42,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "validatorAddress"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "blocks",
                        "txEffects",
                        "droppedTx",
                        "pendingTx",
                        "registeredContractClasses",
                        "contractInstances",
                        "validators",
                        "accounts"
                      ],
                      "type": "object"
                    },
                    "searchPhrase": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "searchPhrase",
                    "results"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Search for blocks by hash, height, or slot; txEffects; contract classes; contract instances; and validators on Aztec",
        "tags": [
          "L2",
          "search"
        ]
      }
    },
    "/l2/search/public-logs": {
      "get": {
        "parameters": [
          {
            "description": "The Fr value to search for in the public logs (must start with 0x)",
            "in": "query",
            "name": "frLogEntry",
            "required": true,
            "schema": {
              "pattern": "^0x[0-9a-fA-F]+$",
              "type": "string"
            }
          },
          {
            "description": "The index position in the log array to match the Fr value",
            "in": "query",
            "name": "index",
            "required": true,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "pattern": "^0x[0-9a-fA-F]+$",
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of transaction hashes that contain the specified Fr value in public logs"
          }
        },
        "summary": "Search for transaction effects by Fr value in public logs",
        "tags": [
          "L2",
          "search"
        ]
      }
    },
    "/l2/tips": {
      "get": {
        "description": "Returns the latest L2 tip snapshot observed from AztecNode.getL2Tips(). `nativeStatus` is the product-facing block-display status derived from these tips. On Aztec v4, upstream `finalized` may currently equal `proven`. `checkpointed` means the block is at or below the latest checkpointed tip; `unknown` means tips are missing, stale/degraded, orphaned, or the block is above the proposed tip.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "degraded": {
                      "type": "boolean"
                    },
                    "degradedReason": {
                      "type": "string"
                    },
                    "observedAt": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "repeatedDegradedBoundaryMismatch": {
                      "properties": {
                        "bucket": {
                          "enum": [
                            "finalized",
                            "proven",
                            "checkpointed",
                            "proposed"
                          ],
                          "type": "string"
                        },
                        "expectedHash": {},
                        "firstSeenAt": {
                          "type": "string"
                        },
                        "height": {
                          "maximum": 9007199254740991,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "lastSeenAt": {
                          "type": "string"
                        },
                        "observedDbHash": {},
                        "occurrenceCount": {
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991,
                          "type": "integer"
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "bucket",
                        "height",
                        "expectedHash",
                        "firstSeenAt",
                        "lastSeenAt",
                        "occurrenceCount",
                        "reason"
                      ],
                      "type": "object"
                    },
                    "source": {
                      "properties": {
                        "aztecNodeVersion": {
                          "type": "string"
                        },
                        "rpcNodeName": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "stale": {
                      "type": "boolean"
                    },
                    "staleAfterMs": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "stalenessMs": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "tips": {
                      "properties": {
                        "checkpointed": {
                          "properties": {
                            "block": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            },
                            "checkpoint": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "block",
                            "checkpoint"
                          ],
                          "type": "object"
                        },
                        "finalized": {
                          "properties": {
                            "block": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            },
                            "checkpoint": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "block",
                            "checkpoint"
                          ],
                          "type": "object"
                        },
                        "proposed": {
                          "properties": {
                            "hash": {},
                            "number": {
                              "maximum": 9007199254740991,
                              "minimum": 0,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "number",
                            "hash"
                          ],
                          "type": "object"
                        },
                        "proposedCheckpoint": {
                          "properties": {
                            "block": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            },
                            "checkpoint": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "block",
                            "checkpoint"
                          ],
                          "type": "object"
                        },
                        "proven": {
                          "properties": {
                            "block": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            },
                            "checkpoint": {
                              "properties": {
                                "hash": {},
                                "number": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "number",
                                "hash"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "block",
                            "checkpoint"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "proposed",
                        "checkpointed",
                        "proven",
                        "finalized"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
