    "/l2/blocks/{blockHeight}/txEffects": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "blockHeight",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "blockHash": {},
                      "blockHeight": {
                        "type": "string"
                      },
                      "contractClassLogs": {
                        "items": {
                          "properties": {
                            "contractAddress": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            },
                            "emittedLength": {
                              "type": "number"
                            },
                            "fields": {
                              "items": {
                                "maxLength": 66,
                                "minLength": 66,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              },
                              "type": "array"
                            }
                          },
                          "required": [
                            "contractAddress",
                            "fields",
                            "emittedLength"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "feePayer": {
                        "maxLength": 66,
                        "minLength": 66,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "feePaymentMethod": {
                        "type": "string"
                      },
                      "initiator": {
                        "maxLength": 66,
                        "minLength": 66,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "isOrphaned": {
                        "type": "boolean"
                      },
                      "l2ToL1Msgs": {
                        "items": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "noteHashes": {
                        "items": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "nullifiers": {
                        "items": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "privateLogs": {
                        "items": {
                          "properties": {
                            "emittedLength": {
                              "type": "number"
                            },
                            "fields": {
                              "items": {
                                "maxLength": 66,
                                "minLength": 66,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
                              },
                              "type": "array"
                            }
                          },
                          "required": [
                            "fields",
                            "emittedLength"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "publicCallRequests": {
                        "items": {
                          "properties": {
                            "callType": {
                              "enum": [
                                "non_revertible",
                                "revertible",
                                "teardown"
                              ],
                              "type": "string"
                            },
                            "calldataHash": {},
                            "contractAddress": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            },
                            "contractName": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "functionName": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "functionSelector": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "isStaticCall": {
                              "type": "boolean"
                            },
                            "msgSender": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            },
                            "timestamp": {
                              "type": [
                                "number",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "msgSender",
                            "contractAddress",
                            "isStaticCall",
                            "calldataHash",
                            "callType"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "publicDataWrites": {
                        "items": {
                          "properties": {
                            "leafSlot": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            },
                            "value": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            }
                          },
                          "required": [
                            "leafSlot",
                            "value"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "publicLogs": {
                        "items": {
                          "properties": {
                            "contractAddress": {
                              "maxLength": 66,
                              "minLength": 66,
                              "pattern": "^0x[0-9a-fA-F]+$",
                              "type": "string"
                            },
                            "fields": {
                              "items": {
                                "maxLength": 66,
                                "minLength": 66,
                                "pattern": "^0x[0-9a-fA-F]+$",
                                "type": "string"
