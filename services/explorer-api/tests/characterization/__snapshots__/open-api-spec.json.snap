    "/l2/public-call-requests": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "contractAddress",
            "required": false,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "senderAddress",
            "required": false,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "callType": {
                        "enum": [
                          "non_revertible",
                          "revertible",
                          "teardown"
                        ],
                        "type": "string"
                      },
                      "calldataHash": {
                        "type": "string"
                      },
                      "contractAddress": {
                        "type": "string"
                      },
                      "contractName": {
                        "nullable": true,
                        "type": "string"
                      },
                      "functionName": {
                        "nullable": true,
                        "type": "string"
                      },
                      "functionSelector": {
                        "nullable": true,
                        "type": "string"
                      },
                      "isStaticCall": {
                        "type": "boolean"
                      },
                      "msgSender": {
                        "type": "string"
                      },
                      "timestamp": {
                        "nullable": true,
                        "type": "number"
                      },
                      "txHash": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Public call requests matching the given filter"
          },
          "400": {
            "description": "Bad request — provide exactly one of contractAddress or senderAddress (not both, not neither)"
          }
        },
        "summary": "Get public call requests filtered by contractAddress or senderAddress query param",
        "tags": [
          "L2",
          "public-call-requests"
        ]
      }
    },
