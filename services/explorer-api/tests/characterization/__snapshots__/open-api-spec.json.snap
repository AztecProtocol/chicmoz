                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "updatedAt": {
                                  "format": "date-time",
                                  "type": "string"
                                },
                                "uploadedAt": {
                                  "format": "date-time",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "name",
                                "origin",
                                "comment"
                              ],
                              "type": "object"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "contractIdentifier": {
                          "type": "string"
                        },
                        "contractType": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "creatorContact": {
                          "type": "string"
                        },
                        "creatorName": {
                          "type": "string"
                        },
                        "details": {
                          "type": "string"
                        },
                        "repoUrl": {
                          "type": "string"
                        },
                        "reviewedAt": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "uploadedAt": {
                          "format": "date-time",
                          "type": "string"
                        }
                      },
                      "required": [
                        "address",
                        "contractIdentifier",
                        "details",
                        "creatorName",
                        "creatorContact",
                        "appUrl",
                        "repoUrl",
                        "uploadedAt"
                      ],
                      "type": "object"
                    },
                    "immutablesHash": {
                      "maxLength": 66,
                      "minLength": 66,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "initializationHash": {
                      "maxLength": 66,
                      "minLength": 66,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "isOrphaned": {
                      "type": "boolean"
                    },
                    "originalContractClassId": {
                      "maxLength": 66,
                      "minLength": 66,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "packedBytecode": {},
                    "privateFunctionsRoot": {
                      "maxLength": 66,
                      "minLength": 66,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "publicKeys": {
                      "properties": {
                        "masterIncomingViewingPublicKey": {
                          "maxLength": 130,
                          "minLength": 130,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "masterNullifierPublicKey": {
                          "maxLength": 130,
                          "minLength": 130,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "masterOutgoingViewingPublicKey": {
                          "maxLength": 130,
                          "minLength": 130,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "masterTaggingPublicKey": {
                          "maxLength": 130,
                          "minLength": 130,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "masterNullifierPublicKey",
                        "masterIncomingViewingPublicKey",
                        "masterOutgoingViewingPublicKey",
                        "masterTaggingPublicKey"
                      ],
                      "type": "object"
                    },
                    "salt": {
                      "maxLength": 66,
                      "minLength": 66,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "selectorMap": {
                      "anyOf": [
                        {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "propertyNames": {
                            "type": "string"
                          },
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sourceCodeUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "standardContractType": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "standardContractVersion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "verifiedDeploymentArguments": {
                      "properties": {
                        "address": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "constructorArgs": {
                          "items": {
                            "type": "string"
                          },
                          "maxItems": 4096,
                          "type": "array"
                        },
                        "deployer": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "id": {
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                          "type": "string"
                        },
                        "immutablesHash": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        "publicKeysString": {
                          "type": "string"
                        },
                        "salt": {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "address",
                        "salt",
                        "deployer",
                        "publicKeysString",
                        "constructorArgs"
                      ],
                      "type": "object"
                    },
                    "version": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "address",
                    "blockHash",
                    "version",
                    "salt",
                    "currentContractClassId",
                    "originalContractClassId",
                    "initializationHash",
                    "immutablesHash",
                    "deployer",
                    "publicKeys",
                    "contractClassId",
                    "artifactHash",
                    "privateFunctionsRoot",
                    "packedBytecode",
                    "isOrphaned"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get contract instance by address",
        "tags": [
          "L2",
          "contract-instances"
        ]
      },
      "post": {
        "description": "Please check out our SDK for how to verify contract instance deployment",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "deployerMetadata": {
                    "properties": {
                      "appUrl": {
                        "type": "string"
                      },
                      "contractIdentifier": {
                        "type": "string"
                      },
                      "contractType": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "creatorContact": {
                        "type": "string"
                      },
                      "creatorName": {
                        "type": "string"
                      },
                      "details": {
                        "type": "string"
                      },
                      "repoUrl": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "contractIdentifier",
                      "details",
                      "creatorName",
                      "creatorContact",
                      "appUrl",
                      "repoUrl"
                    ],
                    "type": "object"
                  },
                  "verifiedDeploymentArguments": {
                    "properties": {
                      "constructorArgs": {
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 4096,
                        "type": "array"
                      },
                      "deployer": {
                        "maxLength": 66,
                        "minLength": 66,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "immutablesHash": {
                        "maxLength": 66,
                        "minLength": 66,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "publicKeysString": {
                        "type": "string"
                      },
                      "salt": {
                        "maxLength": 66,
                        "minLength": 66,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "stringifiedArtifactJson": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "salt",
                      "deployer",
                      "publicKeysString",
                      "constructorArgs"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "verifiedDeploymentArguments"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contract instance verification successful"
          },
          "400": {
            "description": "Bad request or verification failed"
          },
          "404": {
            "description": "Contract instance not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "summary": "Verify contract instance deployment",
        "tags": [
          "L2",
          "contract-instances"
        ]
      }
    },
    "/l2/contract-instances/{address}/balance": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "isPublic",
            "schema": {
              "default": true,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "balance": {
                      "type": "string"
                    },
                    "blockNumber": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "contractAddress": {
                      "maxLength": 66,
                      "minLength": 66,
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "type": "string"
                    },
                    "feeRecipient": {
                      "anyOf": [
                        {
                          "maxLength": 66,
                          "minLength": 66,
                          "pattern": "^0x[0-9a-fA-F]+$",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sourceTxHash": {},
                    "timestamp": {
                      "default": 1767225600000,
                      "type": "number"
                    }
                  },
                  "required": [
                    "contractAddress",
                    "balance",
                    "timestamp"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get contract instance balance by address",
        "tags": [
          "L2",
          "contract-instances"
        ]
      }
    },
    "/l2/contract-instances/{address}/balance/history": {
      "get": {
        "description": "Returns the balance history for a contract instance, ordered chronologically by timestamp. Results are limited to the 1000 most recent entries for performance optimization.",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "balance": {
                        "type": "string"
                      },
                      "blockNumber": {
                        "format": "int64",
                        "type": "integer"
                      },
                      "contractAddress": {
                        "maxLength": 66,
                        "minLength": 66,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "feeRecipient": {
                        "anyOf": [
                          {
                            "maxLength": 66,
                            "minLength": 66,
                            "pattern": "^0x[0-9a-fA-F]+$",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sourceTxHash": {},
                      "timestamp": {
                        "default": 1767225600000,
                        "type": "number"
                      }
                    },
                    "required": [
                      "contractAddress",
                      "balance",
                      "timestamp"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get contract instance balance history by address (limited to 1000 most recent entries)",
        "tags": [
          "L2",
          "contract-instances"
        ]
      }
    },
    "/l2/contract-instances/{address}/fpc-relationships": {
      "get": {
        "description": "Returns which FPCs pay fees for this address, and (if the address is itself an FPC) which addresses it sponsors.",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "feePayers": {
                      "description": "FPC addresses that pay fees for this address",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "sponsoredAddresses": {
                      "description": "Addresses for which this FPC pays fees (only populated when the address is an FPC)",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "FPC relationships for the address"
          }
        },
        "summary": "Get Fee Paying Contract (FPC) relationships for an address",
        "tags": [
          "L2",
          "contract-instances"
        ]
      }
    },
    "/l2/contract-instances/{address}/fpc-transactions": {
      "get": {
        "description": "Returns transactions where this address paid fees for others (asFeePayer) and where others paid fees for this address (asSponsored).",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "asFeePayer": {
                      "items": {
                        "properties": {
                          "blockHeight": {
                            "type": "integer"
                          },
                          "feePayer": {
                            "type": "string"
                          },
                          "sponsoredAddress": {
                            "type": "string"
                          },
                          "timestamp": {
                            "type": "integer"
                          },
                          "transactionFee": {
                            "type": "string"
                          },
                          "txHash": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "asSponsored": {
                      "items": {
                        "properties": {
                          "blockHeight": {
                            "type": "integer"
                          },
                          "feePayer": {
                            "type": "string"
                          },
                          "sponsoredAddress": {
                            "type": "string"
                          },
                          "timestamp": {
                            "type": "integer"
                          },
                          "transactionFee": {
                            "type": "string"
                          },
                          "txHash": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "FPC transactions for the address"
          }
        },
        "summary": "Get FPC-related transactions for an address",
        "tags": [
          "L2",
          "contract-instances"
        ]
      }
    },
    "/l2/dropped-txs/{hash}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "hash",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get dropped transaction by hash",
        "tags": [
          "L2",
          "dropped-txs",
          "tx-effects"
        ]
      }
    },
    "/l2/errors": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "cause": {
                        "type": "string"
                      },
                      "count": {
                        "type": "number"
                      },
                      "createdAt": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "data": {},
                      "lastSeenAt": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "rpcNodeName": {
                        "type": "string"
                      },
                      "rpcUrl": {
                        "type": "string"
                      },
                      "stack": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "rpcNodeName",
                      "name",
                      "cause",
                      "message",
                      "stack",
                      "data",
                      "count",
                      "createdAt",
                      "lastSeenAt"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get L2 chain errors",
        "tags": [
          "l2-chain"
        ]
      }
    },
    "/l2/fee-recipients": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "calculatedForNumberOfBlocks": {
                        "type": "number"
                      },
                      "feesReceived": {
                        "type": "string"
                      },
                      "l2Address": {
                        "maxLength": 66,
                        "minLength": 66,
                        "pattern": "^0x[0-9a-fA-F]+$",
                        "type": "string"
                      },
                      "nbrOfBlocks": {
                        "type": "number"
                      },
                      "partOfTotalFeesReceived": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "l2Address",
                      "feesReceived",
                      "nbrOfBlocks",
                      "calculatedForNumberOfBlocks"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get fee recipients",
        "tags": [
          "L2",
          "fee-recipients"
        ]
      }
    },
    "/l2/info": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "createdAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "feeJuiceDecimals": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "feeJuiceSymbol": {
                      "type": "string"
                    },
                    "l1ChainId": {
                      "type": "number"
                    },
                    "l1ContractAddresses": {
                      "properties": {
                        "coinIssuerAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "feeJuiceAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "feeJuicePortalAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "governanceAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "governanceProposerAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "inboxAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "outboxAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "registryAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "rewardDistributorAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "rollupAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "stakingAssetAddress": {
                          "pattern": "^0x.*",
                          "type": "string"
                        }
                      },
                      "required": [
                        "rollupAddress",
                        "registryAddress",
                        "inboxAddress",
                        "outboxAddress",
                        "feeJuiceAddress",
                        "feeJuicePortalAddress",
                        "coinIssuerAddress",
                        "rewardDistributorAddress",
                        "governanceProposerAddress",
                        "governanceAddress",
                        "stakingAssetAddress"
                      ],
                      "type": "object"
                    },
                    "l2NetworkId": {
                      "enum": [
                        "MAINNET",
                        "SANDBOX",
                        "DEVNET",
                        "TESTNET"
                      ],
                      "type": "string"
                    },
                    "latestUpdateAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "protocolContractAddresses": {
                      "properties": {
                        "classRegistry": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "feeJuice": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "instanceRegistry": {
                          "pattern": "^0x.*",
                          "type": "string"
                        },
                        "multiCallEntrypoint": {
                          "pattern": "^0x.*",
                          "type": "string"
                        }
                      },
                      "required": [
                        "classRegistry",
                        "feeJuice",
                        "instanceRegistry",
                        "multiCallEntrypoint"
                      ],
                      "type": "object"
                    },
                    "rollupVersion": {
                      "type": "string"
                    },
                    "stakingAssetDecimals": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "stakingAssetSymbol": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "l2NetworkId",
                    "l1ChainId",
                    "rollupVersion",
                    "l1ContractAddresses",
                    "protocolContractAddresses"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Get L2 chain info",
        "tags": [
          "l2-chain"
        ]
      }
    },
    "/l2/l2-to-l1-msgs/contract/{address}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "pattern": "^0x[a-fA-F0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "contractAddress": {
                        "type": "string"
                      },
                      "index": {
                        "type": "number"
                      },
                      "recipient": {
                        "type": "string"
                      },
                      "txHash": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "L2-to-L1 messages emitted by the contract"
          }
