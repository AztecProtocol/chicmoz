                      "nullable": true,
                      "type": "string"
                    },
                    "compileOutput": {
                      "nullable": true,
                      "type": "string"
                    },
                    "contractClassId": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "error": {
                      "nullable": true,
                      "type": "string"
                    },
                    "failureStage": {
                      "nullable": true,
                      "type": "string"
                    },
                    "gitRef": {
                      "nullable": true,
                      "type": "string"
                    },
                    "githubUrl": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "subPath": {
                      "nullable": true,
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    },
                    "version": {
                      "type": "number"
