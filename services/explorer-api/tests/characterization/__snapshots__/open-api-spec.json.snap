                          "null"
                        ]
                      },
                      "standardContractVersion": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "verifiedDeploymentArguments": {
                        "properties": {
                          "address": {
                            "maxLength": 66,
                            "minLength": 66,
                            "pattern": "^0x[0-9a-fA-F]+$",
                            "type": "string"
                          },
                          "constructorArgs": {
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 4096,
                            "type": "array"
                          },
                          "deployer": {
                            "maxLength": 66,
                            "minLength": 66,
                            "pattern": "^0x[0-9a-fA-F]+$",
                            "type": "string"
                          },
                          "id": {
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                            "type": "string"
                          },
                          "immutablesHash": {
                            "maxLength": 66,
                            "minLength": 66,
                            "pattern": "^0x[0-9a-fA-F]+$",
                            "type": "string"
                          },
                          "publicKeysString": {
                            "type": "string"
                          },
                          "salt": {
                            "maxLength": 66,
                            "minLength": 66,
                            "pattern": "^0x[0-9a-fA-F]+$",
