{
  "name": "@chicmoz/explorer-api",
  "description": "Store and serve aztec blockchain data",
  "version": "1.0.0",
  "main": "index.js",
  "license": "Apache-2.0",
  "dependencies": {
    "@anatine/zod-openapi": "2.2.6",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/protocol-contracts": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@chicmoz-pkg/backend-utils": "workspace:^",
    "@chicmoz-pkg/contract-verification": "workspace:^",
    "@chicmoz-pkg/error-middleware": "workspace:^",
    "@chicmoz-pkg/logger-server": "workspace:^",
    "@chicmoz-pkg/message-bus": "workspace:^",
    "@chicmoz-pkg/message-registry": "workspace:^",
    "@chicmoz-pkg/microservice-base": "workspace:^",
    "@chicmoz-pkg/postgres-helper": "workspace:^",
    "@chicmoz-pkg/redis-helper": "workspace:^",
    "@chicmoz-pkg/types": "workspace:^",
    "@defi-wonderland/aztec-standards-v410": "npm:@defi-wonderland/aztec-standards@4.1.0-rc.4",
    "@defi-wonderland/aztec-standards-v420": "npm:@defi-wonderland/aztec-standards@4.2.0-aztecnr-rc.2",
    "cors": "2.8.5",
    "drizzle-orm": "0.33.0",
    "express": "4.22.3",
    "express-async-handler": "1.2.0",
    "helmet": "7.0.0",
    "morgan": "1.12.1",
    "openapi3-ts": "^4.4.0",
    "pg": "8.11.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@aztec-labs/noir-contracts.js": "6.0.0",
    "@chicmoz/test-harness": "workspace:^",
    "@types/cors": "2.8.13",
    "@types/express": "4.17.17",
    "@types/morgan": "1.9.4",
    "@types/node": "20.5.0",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "6.11.0",
    "@typescript-eslint/parser": "6.11.0",
    "bson": "6.2.0",
    "drizzle-kit": "0.24.2",
    "eslint": "8.53.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.29.0",
    "supertest": "6.3.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "scripts": {
    "prebuild": "rm -rf build; mkdir build",
    "build": "yarn tsc",
    "postbuild": "ln -s ../public build/public",
    "predev": "yarn build",
    "dev": "yarn node build/src/index.js",
    "generate": "yarn build && L2_NETWORK_ID=SANDBOX drizzle-kit generate",
    "migrate": "yarn node build/scripts/migrate.js",
    "start": "yarn node --unhandled-rejections=strict --enable-source-maps build/src/index.js",
    "lint": "yarn run lint-base --ext .ts .",
    "lint-base": "yarn run g:lint",
    "test": "vitest run",
    "test-once": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "type": "module"
}
